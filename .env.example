# Every variable here is validated at startup (src/config.ts); a bad value
# fails the boot with a message. Values shown are the defaults.

# --- Service -----------------------------------------------------------------
DATABASE_URL=postgres://orders:orders@localhost:5433/orders
PORT=3000
LOG_LEVEL=info
# development pretty-prints logs; production and test emit JSON
NODE_ENV=development
# Browser origins allowed to call the API, comma separated.
# Empty: the UI is served from the same origin and no CORS headers are sent.
CORS_ORIGINS=

# --- Database budgets ----------------------------------------------------------
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# --- Third parties -------------------------------------------------------------
# A charge that exceeds this is indeterminate, never a decline.
PAYMENTS_TIMEOUT_MS=15000
GEOCODING_TIMEOUT_MS=3000
# Mocked gateway only (src/services/payments.ts)
PAYMENTS_FAILURE_RATE=0
PAYMENTS_LATENCY_MS=120

# --- Reconciliation of unknown charge outcomes ---------------------------------
# Zero disables the in-process scheduler.
RECONCILE_INTERVAL_MS=30000
# Must be at least twice PAYMENTS_TIMEOUT_MS.
RECONCILE_AFTER_MS=300000
RECONCILE_BATCH_SIZE=50

# --- Idempotency key retention -------------------------------------------------
IDEMPOTENCY_RETENTION_MS=86400000
# Zero disables the purge.
IDEMPOTENCY_PURGE_INTERVAL_MS=3600000
